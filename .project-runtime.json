{
  "language": "Go",
  "project_shape": "backend",
  "source_extensions": [
    ".go"
  ],
  "build_command": "go build -trimpath -o bin/forged ./cmd/forged",
  "testing": "deferred",
  "runtime_dependencies": [
    "Go >= 1.24",
    "FFmpeg with libx264, aac, loudnorm, showwavespic, tile, subtitles (libass)",
    "A font covering burned caption languages (FORGE_BURN_FONT)"
  ],
  "workflow_checks": [
    {
      "workflow_id": "ingest",
      "command": "python3 scripts/workflow_check.py --workflow ingest",
      "timeout_seconds": 120
    },
    {
      "workflow_id": "recipe-version",
      "command": "python3 scripts/workflow_check.py --workflow recipe-version",
      "timeout_seconds": 120
    },
    {
